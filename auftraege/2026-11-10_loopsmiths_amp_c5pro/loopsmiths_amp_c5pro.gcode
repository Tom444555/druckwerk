; WIPE_TOWER_START
M220 S100
; CP TOOLCHANGE UNLOAD
;WIDTH:1
;WIDTH:0.5
M400

G1 E-3 F1800
;WIPE_START
G1 F12000
G1 X86.762 Y103.09
G1 X86.243 Y103.09
